      "id": "place_value_decompose_3digit",
      "skill": "PLACE_VALUE_HUNDREDS_TENS_ONES",
      "status": "VERIFIED_A_TEMPLATE",
      "variables": {"h":{"min":1,"max":9},"t":{"min":0,"max":9},"o":{"min":0,"max":9}},
      "derive": {"n":"100*h + 10*t + o"},
      "prompt_vi": "Số {n} gồm bao nhiêu trăm, chục và đơn vị?",
      "answer": {"hundreds":"h","tens":"t","ones":"o"},
      "validator": ["1 <= h <= 9","0 <= t <= 9","0 <= o <= 9","100 <= n <= 999"]
    },
    {
      "id": "expanded_form_3digit",
      "skill": "NUM_EXPANDED_FORM_HTO",
      "status": "VERIFIED_A_TEMPLATE",
      "variables": {"h":{"min":1,"max":9},"t":{"min":0,"max":9},"o":{"min":0,"max":9}},
      "derive": {"n":"100*h + 10*t + o","expanded":"100*h + 10*t + o"},
      "prompt_vi": "Viết {n} thành tổng của trăm, chục và đơn vị.",
      "answer_expression": "100*h + 10*t + o"
    },
    {
      "id": "predecessor_successor",
      "skill": "NUM_PREDECESSOR_SUCCESSOR",
      "status": "VERIFIED_A_TEMPLATE",
      "variables": {"n":{"min":1,"max":999}},
      "prompt_vi": "Số liền trước và số liền sau của {n} là gì?",
      "answer": {"previous":"n-1","next":"n+1"},
      "validator": ["1 <= n <= 999","0 <= n-1","n+1 <= 1000"]
    },
    {
      "id": "compare_two_numbers_1000",
      "skill": "NUM_COMPARE_0_1000",
      "status": "VERIFIED_A_TEMPLATE",
      "variables": {"a":{"min":0,"max":1000},"b":{"min":0,"max":1000}},
      "constraint": "a != b",
      "prompt_vi": "Điền dấu > hoặc < : {a} __ {b}",
      "answer_expression": "'>' if a>b else '<'"
    },
    {
      "id": "add_within_1000_no_carry",
      "skill": "ADD_WITHIN_1000_NO_CARRY",
      "status": "VERIFIED_A_TEMPLATE",
      "variables": {"a":{"min":0,"max":999},"b":{"min":0,"max":999}},
      "constraint": "a+b <= 1000 AND ones(a)+ones(b)<10 AND tens(a)+tens(b)<10 AND hundreds(a)+hundreds(b)<10",
      "prompt_vi": "Tính: {a} + {b} = ?",
      "answer_expression": "a+b",
      "validator": ["answer == a+b","answer <= 1000","carry_count(a,b) == 0"]
    },
    {
      "id": "add_within_1000_one_carry",
      "skill": "ADD_WITHIN_1000_ONE_CARRY_MAX",
      "status": "VERIFIED_A_TEMPLATE",
      "variables": {"a":{"min":0,"max":999},"b":{"min":0,"max":999}},
      "constraint": "a+b <= 1000 AND carry_count(a,b) == 1",
      "prompt_vi": "Tính: {a} + {b} = ?",
      "answer_expression": "a+b",
      "validator": ["answer == a+b","answer <= 1000","carry_count(a,b) == 1"]
    },
    {
